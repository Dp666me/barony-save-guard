<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BaronySaveGuard</AssemblyName>
    <RootNamespace>BaronySaveGuard.App</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    WinForms is referenced directly instead of through UseWindowsForms so the app also builds
    with Linux .NET SDKs that ship without the WindowsDesktop SDK. It still only runs on Windows.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaronySaveGuard.Core\BaronySaveGuard.Core.csproj" />
  </ItemGroup>

</Project>
